# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./anamnesis.db
# Production (Supabase free tier): copy the Session pooler connection string
# from Supabase → Settings → Database. The postgres:// scheme is normalised
# to postgresql+asyncpg:// automatically at startup.
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/anamnesis_ai
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_CONNECT_TIMEOUT=5

# ── LLM Providers (Gemini only) ──────────────────────────────────────────────
GEMINI_API_KEY=your_key_here
# Primary model (high throughput):
GEMINI_MODEL=gemini-flash-lite-latest
# Automatic fallback order when the primary hits quota/rate limits:
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest

# ── CORS ──────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Application ───────────────────────────────────────────────────────────────
# APP_ENV=development
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# MAX_INPUT_LENGTH=2000
# MAX_CONCURRENT_SIMULATIONS=10
# CRITIC_CONFIDENCE_THRESHOLD=75
# CRITIC_MAX_ITERATIONS=2

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# CHROMA_DB_PATH=./chroma_db
