# ==============================================================================
# Anamnesis-AI Backend Environment Configuration (Template)
# ==============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/anamnesis_ai
# DATABASE_URL=sqlite+aiosqlite:///./anamnesis.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=5

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MAX_TOKENS=1024

# CORS & Server Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# Simulation & Critic Tuning
MAX_INPUT_LENGTH=2000
MAX_CONCURRENT_SIMULATIONS=10
CRITIC_CONFIDENCE_THRESHOLD=75
CRITIC_MAX_ITERATIONS=2

# Vector Storage (ChromaDB)
# CHROMA_DB_PATH=

# External RAG Data Sources (Optional)
NASA_API_KEY=DEMO_KEY
NOAA_TOKEN=
FOUNDRY_IQ_ENDPOINT=
FOUNDRY_IQ_TOKEN=
